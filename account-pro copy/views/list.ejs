<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>记账本</title>
    <style>
      .detail {
        border: 1px solid #ccc;
        margin: 30px;
      }
      .date {
        border-bottom: 1px solid #ccc;
        height: 50px;
        line-height: 50px;
        padding: 0 20px;
      }
      .item {
        height: 50px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 20px;
      }
      .pink {
        background-color: pink;
      }
      .skyblue{
        background-color: skyblue;
      }
      .item div{
        width: 140px;
      }
      .item .type{
        width: 40px;
        padding: 5px;
        border-radius: 5px;
      }
      .green {
        background-color: green;
      }
      .orange {
        background-color: orange;
      }
    </style>
  </head>
  <body>
    <div>
      <h1>记账本</h1>
      <div><button><a href="/account/create">添加账本</a></button></div>
      <%result.forEach((item) => {%>
        <div class="detail">
        <div class="date <%= item.type == 1 ? 'pink' : 'skyblue'%>"><%= moment(item.time).format("YYYY-MM-DD") %></div>
        <div class="item">
          <div><%=item.title%></div>
          <div class="type <%= item.type == 1 ? 'green' : 'orange'%>">
            <%= item.type == 1 ? '收入' : '支出'%>
          </div>
          <div><%=item.account%> 元</div>
          <div><%=item.remark%></div>
          <div>
            <a class="delBtn" href="/account/<%=item.id%>">删除</a>
          </div>
        </div>
      </div>
      <%})%>
    </div>
  </body>
  <script>

    const delBtns = document.querySelectorAll('.delBtn')
    delBtns.forEach((item) => {
      item.addEventListener('click', (e) => {
        if (confirm('确定删除吗？')) {
          return true
        } else {
          // 阻止默认行为
          e.preventDefault()
        }
      })
    })
  </script>
</html>
