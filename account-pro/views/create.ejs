<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>添加记录</title>
  </head>
  <body>
    <h1>添加记录</h1>
    <form action="/account" method="post">
      <div>
        <label for="title">事项 </label>
        <input type="text" name="title" id="name" required />
      </div>
      <div>
        <label for="time">发生时间 </label>
        <input type="date" name="time" id="time" required />
      </div>
      <div>
        <label for="type">类型 </label>
        <select name="type" id="type" required style="width: 120px">
          <option value="1">收入</option>
          <option value="-1">支出</option>
        </select>
      </div>
      <div>
        <label for="account">金额 </label>
        <input type="text" name="account" id="account" required />
      </div>
      <div>
        <label for="remark">备注 </label>
        <input type="text" name="remark" id="remark" required />
      </div>
      <button>添加</button>
    </form>
  </body>
</html>
